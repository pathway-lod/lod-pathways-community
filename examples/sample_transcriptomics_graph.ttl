# ===========================================================================
# CASE 5d. Pathway co-expression (alpha-tomatine biosynthesis, PWY18C3-3)
# The pathway's genes are co-expressed more than 10,000 random gene sets of the same size.
# One claim on the PlantCyc ID, two evidence nodes (MEANtools, ATTED-II).
# ===========================================================================

lodp:claim_PWY18C3-3_type_CoexpressedGenePathway a lodp:PathwayCoexpressionClaim ;
    rdfs:label "Genes of α-tomatine biosynthesis are co-expressed more than random gene sets" ;
    sio:SIO_000628 plantcyc:PWY18C3-3 ;
    sio:SIO_000772 lodp:evidence_PWY18C3-3_type_CoexpressedGenePathway_atted_Sly_r_c6_0,
        lodp:evidence_PWY18C3-3_type_CoexpressedGenePathway_meantools_rpkm ;
    rdf:object lodp:CoexpressedGenePathway ;
    rdf:predicate rdf:type ;
    rdf:subject plantcyc:PWY18C3-3 .

lodp:evidence_PWY18C3-3_type_CoexpressedGenePathway_atted_Sly_r_c6_0 a obo:ECO_0006069,
        obo:ECO_0007590 ;
    obo:OBI_0000175 "9.999000099990002e-05"^^xsd:double ;
    rdfs:comment "genes used (4 of 7 PlantMetWiki genes with a Solyc locus): GAME1, GAME8, GAME4, GAME12; random sets: mean r 0.2889, SD 0.1211" ;
    prov:wasGeneratedBy lodp:run_pathway_coexpression_atted_Sly_r_c6_0 ;
    lodp:geneCount 4 ;
    lodp:meanPairwiseCorrelation "0.7970096282591507"^^xsd:double ;
    lodp:randomSetCount 10000 .

lodp:evidence_PWY18C3-3_type_CoexpressedGenePathway_meantools_rpkm a obo:ECO_0006069,
