    obo:OBI_0000175 "9.999000099990002e-05"^^xsd:double ;
    rdfs:comment "genes used (6 of 7 PlantMetWiki genes with a Solyc locus): GAME1, GAME8, GAME17, GAME18, GAME4, GAME12; random sets: mean r 0.0016, SD 0.0888" ;
    prov:wasGeneratedBy lodp:run_pathway_coexpression_meantools_rpkm ;
