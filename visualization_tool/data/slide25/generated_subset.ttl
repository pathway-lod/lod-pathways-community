lodp:annotation_MTBLS14270_neg_589_QQGLQYQXUKHWPX a lodp:MetaboliteAnnotation ;
    sio:SIO_000772 [ a obo:ECO_0001580,
                obo:ECO_0007669 ;
            prov:wasGeneratedBy lodp:run_ms2query ;
            lodp:identificationTier "ms2query_exact" ;
            lodp:ms2queryModelScore 9.364e-01 ;
            lodp:precursorMzDifference 5e-04 ],
        [ a obo:ECO_0001580 ;
            prov:wasGeneratedBy lodp:run_gnps_library ;
            lodp:identificationTier "gnps_library" ;
            lodp:libraryCompoundName "Massbank:PR307271 Benzyl glucosinolate" ] ;
    skos:closeMatch <http://www.wikidata.org/entity/Q27125128>,
        <https://identifiers.org/inchikey/QQGLQYQXUKHWPX-RFEZBLSLSA-M> ;
    lodp:anchorTier "structure_match" ;
    lodp:anchoredToMetabolite <https://identifiers.org/inchikey/QQGLQYQXUKHWPX-RFEZBLSLSA-M> ;
    lodp:feature lodp:feature_MTBLS14270_neg_589 ;
    lodp:matchLevel "connectivity" .

lodp:run_sirius a lodp:AnnotationToolRun ;
    rdfs:label "SIRIUS on the Brassicaceae LC-MS/MS data" ;
    swo:SWO_0004000 "6.1.0" ;
    prov:used <https://www.ebi.ac.uk/metabolights/MTBLS14270> ;
    lodp:software "SIRIUS" .

lodp:feature_MTBLS14270_neg_589 a lodp:MetaboliteFeature ;
    obo:MS_1000465 obo:MS_1000129 ;
    lodp:dataset <https://www.ebi.ac.uk/metabolights/MTBLS14270> ;
    lodp:featureId "589" .

lodp:run_gnps_library a lodp:AnnotationToolRun ;
    rdfs:label "GNPS spectral library search" ;
