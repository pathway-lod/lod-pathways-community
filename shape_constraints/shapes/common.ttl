# Shapes shared by all four cases: claims, evidence nodes, runs (provenance) and metabolite features.
#
# Severity policy:
#   sh:Violation  the data is malformed or incomplete and must not be added to the KG
#   sh:Warning    the data is well formed but weakly supported; it can be added, flagged for review
#
# Pattern strings avoid backslashes on purpose: "[.]" is a literal dot.

@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix lodps:  <https://example.org/lod-pathways/shapes/> .
@prefix lodp:   <https://example.org/lod-pathways/pilot/> .
@prefix obo:    <http://purl.obolibrary.org/obo/> .
@prefix sio:    <http://semanticscience.org/resource/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix swo:    <http://www.ebi.ac.uk/swo/> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix wp:     <http://vocabularies.wikipathways.org/wp#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

# Prefixes available to the SPARQL constraints in all shape files
<https://example.org/lod-pathways/shapes/> a owl:Ontology ;
    rdfs:label "LOD-pathways shapes (draft)" ;
    sh:declare
        [ sh:prefix "lodp"  ; sh:namespace "https://example.org/lod-pathways/pilot/"^^xsd:anyURI ] ,
        [ sh:prefix "obo"   ; sh:namespace "http://purl.obolibrary.org/obo/"^^xsd:anyURI ] ,
        [ sh:prefix "sio"   ; sh:namespace "http://semanticscience.org/resource/"^^xsd:anyURI ] ,
        [ sh:prefix "prov"  ; sh:namespace "http://www.w3.org/ns/prov#"^^xsd:anyURI ] ,
        [ sh:prefix "swo"   ; sh:namespace "http://www.ebi.ac.uk/swo/"^^xsd:anyURI ] ,
        [ sh:prefix "skos"  ; sh:namespace "http://www.w3.org/2004/02/skos/core#"^^xsd:anyURI ] ,
        [ sh:prefix "dcterms" ; sh:namespace "http://purl.org/dc/terms/"^^xsd:anyURI ] ,
        [ sh:prefix "rdf"   ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] ,
        [ sh:prefix "xsd"   ; sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ] .

# ---------------------------------------------------------------------------
# Claims: anything that links data to PlantMetWiki
# ---------------------------------------------------------------------------
lodps:ClaimShape a sh:NodeShape ;
    sh:name "Claim" ;
    sh:description "Every claim has evidence, is anchored to PlantMetWiki, and says how it was anchored." ;
    sh:targetClass lodp:Claim ;
    # anchored in at least one PlantMetWiki pathway or metabolite
    sh:or (
        [ sh:path lodp:anchoredInPathway ; sh:minCount 1 ]
        [ sh:path lodp:anchoredToMetabolite ; sh:minCount 1 ]
    ) ;
    sh:message "A claim must be anchored to PlantMetWiki: give lodp:anchoredInPathway or lodp:anchoredToMetabolite." ;

    sh:property [
        sh:path sio:SIO_000772 ;
        sh:minCount 1 ;
        sh:message "A claim needs at least one evidence node (sio:SIO_000772 'has evidence')." ] ;

    sh:property [
        sh:path lodp:anchoredInPathway ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^http://rdf-plantmetwiki[.]bioinformatics[.]nl/pathways/PC[0-9]+$" ;
        sh:message "lodp:anchoredInPathway must be a PlantMetWiki pathway IRI (http://rdf-plantmetwiki.bioinformatics.nl/pathways/PC<number>)." ] ;

    sh:property [
        sh:path lodp:anchoredToMetabolite ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^https://identifiers[.]org/inchikey/[A-Z]{14}-[A-Z]{10}-[A-Z]$" ;
        sh:message "lodp:anchoredToMetabolite must be an identifiers.org InChIKey IRI (the form PlantMetWiki uses)." ] ;

    sh:property [
        sh:path lodp:anchorTier ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "curated" "gene_direct" "gene_locus" "structure_match" "gene_uniprot" "gene_ec" "mass_match" ) ;
        sh:message "A claim needs exactly one lodp:anchorTier: curated, gene_direct, gene_locus, structure_match, gene_uniprot, gene_ec or mass_match." ] ;

    # Weak anchors are allowed but flagged
    sh:property [
        sh:path lodp:anchorTier ;
        sh:severity sh:Warning ;
        sh:not [ sh:in ( "gene_ec" "mass_match" ) ] ;
        sh:message "Weak anchor: gene_ec (EC number only) or mass_match (MS1 mass only). Review before treating this as a PlantMetWiki-supported claim." ] .

# ---------------------------------------------------------------------------
# Evidence nodes (also the MIBiG match evidence of a BGC)
# ---------------------------------------------------------------------------
lodps:EvidenceShape a sh:NodeShape ;
    sh:name "Evidence" ;
    sh:description "An evidence node is typed with an ECO class and generated by a run." ;
    sh:targetObjectsOf sio:SIO_000772 , lodp:mibigMatchEvidence ;
    sh:nodeKind sh:BlankNodeOrIRI ;

    sh:property [
        sh:path rdf:type ;
        sh:qualifiedValueShape [
            sh:nodeKind sh:IRI ;
            sh:pattern "^http://purl[.]obolibrary[.]org/obo/ECO_[0-9]{7}$" ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "An evidence node must be typed with at least one ECO class (obo:ECO_nnnnnnn)." ] ;

    sh:property [
        sh:path prov:wasGeneratedBy ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class lodp:Run ;
        sh:message "An evidence node needs exactly one prov:wasGeneratedBy pointing to a run (an instance of a lodp:Run subclass)." ] .

# ---------------------------------------------------------------------------
# Runs: provenance of a tool, pipeline or curation effort
# ---------------------------------------------------------------------------
lodps:RunShape a sh:NodeShape ;
    sh:name "Run" ;
    sh:description "A run records which software, which version and which input data produced the evidence." ;
    sh:targetClass lodp:Run ;

    sh:property [
        sh:path lodp:software ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A run needs exactly one lodp:software (name of the tool or resource)." ] ;

    sh:property [
        sh:path swo:SWO_0004000 ;
        sh:maxCount 1 ;
        sh:message "A run has at most one version (swo:SWO_0004000)." ] ;

    sh:property [
        sh:path swo:SWO_0004000 ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Version missing (swo:SWO_0004000). State the software version, or the date and release of the resource." ] ;

    sh:property [
        sh:path prov:used ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A run needs at least one prov:used: the IRI of the input data (dataset, database, DOI)." ] ;

    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "A run should have an rdfs:label." ] .

# ---------------------------------------------------------------------------
# Metabolite features (cases 2 and 3)
# ---------------------------------------------------------------------------
lodps:FeatureShape a sh:NodeShape ;
    sh:name "Metabolite feature" ;
    sh:targetClass lodp:MetaboliteFeature ;
    sh:nodeKind sh:IRI ;

    sh:property [
        sh:path lodp:featureId ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "A feature needs exactly one lodp:featureId (its identifier in the dataset)." ] ;

    sh:property [
        sh:path lodp:dataset ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "A feature needs exactly one lodp:dataset (IRI of the study, e.g. a MetaboLights study)." ] ;

    sh:property [
        sh:path obo:MS_1000465 ;
        sh:maxCount 1 ;
        sh:in ( obo:MS_1000130 obo:MS_1000129 ) ;
        sh:message "The scan polarity (obo:MS_1000465) of a feature must be obo:MS_1000130 (positive scan) or obo:MS_1000129 (negative scan)." ] .
