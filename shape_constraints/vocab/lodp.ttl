# Placeholder vocabulary for the terms that do not exist in any ontology yet.
#
# Everything here is a DRAFT. The namespace is a placeholder (example.org) until a permanent one is chosen,
# for example under w3id.org. Terms that exist in other ontologies (SO, ECO, SIO, STATO, OBI, RO, BFO, PROV, SWO,
# SKOS, EDAM) are NOT redefined here; see ../README.md for the full list.
#
# The class hierarchy matters for validation: the shapes target lodp:Claim and lodp:Run, and
# validate.py passes this file to the validator so that subclasses are found.

@prefix lodp: <https://example.org/lod-pathways/pilot/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sio:  <http://semanticscience.org/resource/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/lod-pathways/pilot/> a owl:Ontology ;
    rdfs:label "LOD-pathways placeholder vocabulary (draft)" .

# ---------------------------------------------------------------------------
# Classes
# ---------------------------------------------------------------------------
lodp:Claim a owl:Class ;
    rdfs:label "claim" ;
    rdfs:comment "A statement that links data (a prediction, an association, an annotation) to PlantMetWiki. Every claim carries evidence and is anchored to a PlantMetWiki node." .

lodp:BGCPathwayLink a owl:Class ; rdfs:subClassOf lodp:Claim ;
    rdfs:label "BGC-pathway link" ;
    rdfs:comment "A predicted biosynthetic gene cluster overlaps a PlantMetWiki pathway (case 1)." .

lodp:GeneMetaboliteAssociation a owl:Class ; rdfs:subClassOf lodp:Claim , sio:SIO_001257 ;
    rdfs:label "gene-metabolite association" ;
    rdfs:comment "A gene and a metabolite feature fall into the same functional cluster of a paired-omics analysis (case 2)." .

lodp:MetaboliteAnnotation a owl:Class ; rdfs:subClassOf lodp:Claim ;
    rdfs:label "metabolite annotation" ;
    rdfs:comment "An untargeted MS feature is annotated as a PlantMetWiki metabolite (case 3)." .

lodp:PathwayMembershipClaim a owl:Class ; rdfs:subClassOf lodp:Claim , rdf:Statement ;
    rdfs:label "pathway membership claim" ;
    rdfs:comment "Evidence for a node of a PlantMetWiki pathway, reified as an rdf:Statement (case 4)." .

lodp:MetaboliteFeature a owl:Class ;
    rdfs:label "metabolite feature" ;
    rdfs:comment "An untargeted mass-spectrometry feature (m/z, retention time) from a dataset." .

lodp:Run a owl:Class ; rdfs:subClassOf prov:Activity ;
    rdfs:label "run" ;
    rdfs:comment "One run of a tool, a pipeline or a curation effort. Carries software, version and input data." .

lodp:PlantiSMASHRun a owl:Class ; rdfs:subClassOf lodp:Run ; rdfs:label "plantiSMASH run" .
lodp:LinkingRun a owl:Class ; rdfs:subClassOf lodp:Run ;
    rdfs:label "linking run" ;
    rdfs:comment "The mapping of predictions to PlantMetWiki nodes (genes to pathways, features to metabolites)." .
lodp:MEANtoolsRun a owl:Class ; rdfs:subClassOf lodp:Run ; rdfs:label "MEANtools run" .
lodp:AnnotationToolRun a owl:Class ; rdfs:subClassOf lodp:Run ;
    rdfs:label "annotation tool run" ;
    rdfs:comment "SIRIUS, MS2Query, DreaMS or a GNPS library search." .
lodp:ConsensusAnnotationRun a owl:Class ; rdfs:subClassOf lodp:Run ; rdfs:label "consensus annotation run" .
lodp:PlantCycCuration a owl:Class ; rdfs:subClassOf lodp:Run ; rdfs:label "PlantCyc curation" .

# ---------------------------------------------------------------------------
# Anchoring to PlantMetWiki (all claims)
# ---------------------------------------------------------------------------
lodp:anchoredInPathway a owl:ObjectProperty ;
    rdfs:label "anchored in pathway" ;
    rdfs:comment "The PlantMetWiki pathway (http://rdf-plantmetwiki.bioinformatics.nl/pathways/PC<n>) the claim is attached to." .
lodp:anchoredToMetabolite a owl:ObjectProperty ;
    rdfs:label "anchored to metabolite" ;
    rdfs:comment "The PlantMetWiki metabolite, as the identifiers.org InChIKey IRI that PlantMetWiki uses (wp:bdbInChIKey)." .
lodp:anchorTier a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "anchor tier" ;
    rdfs:comment "How the anchor was established; for several anchors, the weakest one used. One of: curated, gene_direct, gene_locus, structure_match, gene_uniprot, gene_ec, mass_match (strongest to weakest)." .
lodp:anchoredSide a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "anchored side" ;
    rdfs:comment "For gene-metabolite associations: which side was found in PlantMetWiki (gene, metabolite or both)." .
lodp:geneAnchorTier a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "gene anchor tier" ; rdfs:comment "Tier of the gene-side anchor: gene_locus, gene_uniprot or gene_ec." .
lodp:metaboliteAnchorTier a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "metabolite anchor tier" ; rdfs:comment "Tier of the metabolite-side anchor: mass_match." .

# ---------------------------------------------------------------------------
# Provenance of a run
# ---------------------------------------------------------------------------
lodp:software a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "software" ; rdfs:comment "Name of the tool or resource." .
lodp:usesTool a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "uses tool" ; rdfs:comment "A tool, with its version, that a pipeline run combines." .
lodp:decayRate a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:label "decay rate" ; rdfs:comment "MEANtools: decay rate of the edge weight exp(-(MR-1)/DR)." .

# ---------------------------------------------------------------------------
# Case 1: BGC predictions
# ---------------------------------------------------------------------------
lodp:detectionRule a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "detection rule" ; rdfs:comment "plantiSMASH rule (BGC type) that detected the cluster, e.g. terpene. Hybrids have several." .
lodp:coreDomain a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "core domain" ; rdfs:comment "Core enzyme domain (pHMM) that triggered the rule, e.g. SQHop_cyclase_N." .
lodp:genomeAssembly a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "genome assembly" ; rdfs:comment "Assembly accession the BGC was predicted on, e.g. GCF_000001735.4." .
lodp:mibigMatchEvidence a owl:ObjectProperty ;
    rdfs:label "MIBiG match evidence" ; rdfs:comment "Evidence node for the KnownClusterBLAST match to a MIBiG cluster." .
lodp:percentGenesSimilar a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:label "percent genes similar" ; rdfs:comment "KnownClusterBLAST: percentage of the MIBiG cluster's genes with a similar gene in the BGC (0-100)." .
lodp:linkTier a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "link tier" ; rdfs:comment "gene_direct (same gene ID), gene_uniprot (same UniProt enzyme) or gene_ec (same EC number)." .
lodp:linkingGene a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "linking gene" ; rdfs:comment "A gene (locus) shared by the BGC and the pathway." .
lodp:linkingProtein a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "linking protein" ; rdfs:comment "A UniProt accession shared by the BGC and the pathway." .
lodp:linkingEC a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "linking EC" ; rdfs:comment "An EC number shared by the BGC and the pathway." .
lodp:nSharedGenes a owl:DatatypeProperty ; rdfs:range xsd:integer ; rdfs:label "number of shared genes" .
lodp:nPathwayGenes a owl:DatatypeProperty ; rdfs:range xsd:integer ; rdfs:label "number of pathway genes" ; rdfs:comment "Genes of the pathway that PlantMetWiki lists with the same gene IDs as the BGC." .
lodp:fractionPathwayGenes a owl:DatatypeProperty ; rdfs:range xsd:double ; rdfs:label "fraction of pathway genes" ; rdfs:comment "Shared genes divided by the pathway's genes (0-1)." .
lodp:nSharedEC a owl:DatatypeProperty ; rdfs:range xsd:integer ; rdfs:label "number of shared ECs" .
lodp:fractionPathwayECs a owl:DatatypeProperty ; rdfs:range xsd:double ; rdfs:label "fraction of pathway ECs" ; rdfs:comment "Shared ECs divided by the pathway's ECs (0-1)." .

# ---------------------------------------------------------------------------
# Case 2: paired omics
# ---------------------------------------------------------------------------
lodp:mutualRank a owl:DatatypeProperty ; rdfs:range xsd:double ;
    rdfs:label "mutual rank" ; rdfs:comment "Mutual rank of the gene-metabolite pair (1 = best)." .
lodp:edgeWeight a owl:DatatypeProperty ; rdfs:range xsd:double ;
    rdfs:label "edge weight" ; rdfs:comment "Weight derived from the mutual rank and the decay rate (0-1)." .
lodp:functionalCluster a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "functional cluster" ; rdfs:comment "Identifier of the MEANtools functional cluster (ClusterONE) the pair belongs to." .
lodp:clusterPValue a owl:DatatypeProperty ; rdfs:range xsd:double ;
    rdfs:label "cluster p-value" ; rdfs:comment "ClusterONE p-value of the functional cluster (0-1)." .
lodp:feature a owl:ObjectProperty ; rdfs:range lodp:MetaboliteFeature ; rdfs:label "feature" .
lodp:featureId a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "feature identifier" ; rdfs:comment "Identifier of the feature in its dataset." .
lodp:batchFile a owl:ObjectProperty ; rdfs:label "batch file" ; rdfs:comment "The mzmine batch file (XML) with all parameters of a feature-processing run." .
lodp:dataset a owl:ObjectProperty ; rdfs:label "dataset" ; rdfs:comment "The dataset (e.g. a MetaboLights study) the feature comes from." .
lodp:solycLocus a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "Solyc locus" ; rdfs:comment "Tomato gene locus (SGN/ITAG, e.g. Solyc07g043480) under which PlantMetWiki lists a gene node of a pathway." .

# ---------------------------------------------------------------------------
# Case 3: metabolite annotation
# ---------------------------------------------------------------------------
lodp:identificationTier a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "identification tier" ; rdfs:comment "gnps_library, consensus_inchi, sirius, ms2query_exact or dreams." .
lodp:matchLevel a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "match level" ; rdfs:comment "What the structure match compared: connectivity (first InChIKey block) or full." .
lodp:matchType a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "match type" ; rdfs:comment "Consensus agreement: full (3 of 3 tools) or partial (2 of 3)." .
lodp:matchCategory a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "match category" ; rdfs:comment "What the annotation tools agree on: inchi, class, superclass or pathway." .
lodp:agreementScore a owl:DatatypeProperty ; rdfs:range xsd:double ;
    rdfs:label "agreement score" ; rdfs:comment "Consensus score: 1.0 (full) or 0.5 (partial)." .
lodp:agreeingTool a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "agreeing tool" ; rdfs:comment "A tool that proposed the consensus structure." .
lodp:libraryCompoundName a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "library compound name" .
lodp:ms2queryModelScore a owl:DatatypeProperty ; rdfs:range xsd:double ; rdfs:label "MS2Query model score" .
lodp:precursorMzDifference a owl:DatatypeProperty ; rdfs:range xsd:double ; rdfs:label "precursor m/z difference" ; rdfs:comment "In Da, between the query and the library match." .
lodp:siriusConfidenceApprox a owl:DatatypeProperty ; rdfs:range xsd:double ; rdfs:label "SIRIUS approximate confidence" .
lodp:dreamsSimilarity a owl:DatatypeProperty ; rdfs:range xsd:double ; rdfs:label "DreaMS similarity" .

# ---------------------------------------------------------------------------
# Case 4: PlantCyc
# ---------------------------------------------------------------------------
lodp:originalEvidenceCode a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "original evidence code" ; rdfs:comment "The PlantCyc evidence code as stored in PlantMetWiki (EV-...)." .

# ---------------------------------------------------------------------------
# Transcriptomics and machine-learning predictions (drafts, see specification/SPECIFICATION.md)
# ---------------------------------------------------------------------------
lodp:log2FoldChange a owl:DatatypeProperty ; rdfs:range xsd:double ;
    rdfs:label "log2 fold change" ; rdfs:comment "Log2 of the expression ratio between the two conditions of a contrast (for example the DESeq2 log2FoldChange); positive when higher in the first condition." .
lodp:adjustedPValue a owl:DatatypeProperty ; rdfs:range xsd:double ;
    rdfs:label "adjusted p-value" ; rdfs:comment "p-value after correction for multiple testing (0-1); the correction method is stated next to it." .
lodp:contrast a owl:ObjectProperty ;
    rdfs:label "contrast" ; rdfs:comment "The comparison a differential result refers to: two conditions (treatment, tissue, time point) in a stated direction." .
lodp:predictionScore a owl:DatatypeProperty ; rdfs:range xsd:double ;
    rdfs:label "prediction score" ; rdfs:comment "Score given by a machine-learning model to a predicted link. Whether it is a calibrated probability has to be stated per model." .
lodp:Mass2Motif a owl:Class ; rdfs:label "Mass2Motif" ; rdfs:comment "A topic of an MS2LDA model: a pattern of fragment and neutral-loss m/z values that co-occur in MS/MS spectra." .
lodp:hasMass2Motif a owl:ObjectProperty ; rdfs:domain lodp:MetaboliteFeature ; rdfs:range lodp:Mass2Motif ; rdfs:label "has Mass2Motif" .
lodp:motifProbability a owl:DatatypeProperty ; rdfs:range xsd:double ; rdfs:label "motif probability" ; rdfs:comment "Probability of a Mass2Motif for a feature (0-1)." .
lodp:massErrorPpm a owl:DatatypeProperty ; rdfs:range xsd:double ; rdfs:label "mass error (ppm)" ; rdfs:comment "Difference between the measured and the calculated m/z of a mass match, in ppm." .
lodp:massTolerancePpm a owl:DatatypeProperty ; rdfs:range xsd:double ; rdfs:label "mass tolerance (ppm)" ; rdfs:comment "Tolerance used for a mass match, in ppm." .
lodp:candidateCount a owl:DatatypeProperty ; rdfs:range xsd:integer ; rdfs:label "candidate count" ; rdfs:comment "Number of PlantMetWiki metabolites matching the same feature and adduct." .

# ---------------------------------------------------------------------------
# Case 5: transcriptomics (TX), pilots/transcriptomics_overlap, shapes/transcriptomics.ttl
# ---------------------------------------------------------------------------
# Every TX claim is an rdf:Statement (rdf:subject, rdf:predicate, rdf:object) whose IRI is built from the
# triple; the direction of the effect (up/down, positive/negative) is on each evidence node (lodp:direction),
# so datasets that disagree give conflicting evidence on one claim instead of two opposite claims.
# TX claims refer to the PlantMetWiki nodes they measure and are not anchored (see lodp:TranscriptomicsClaim).
# Details are statements, not extra nodes: the contrast or condition that is a claim's object is an IRI with
# no statements of its own, and what it stands for is stated on the claim; the input matrix and the
# normalisation are stated on the run.
@prefix obo:  <http://purl.obolibrary.org/obo/> .
@prefix efo:  <http://www.ebi.ac.uk/efo/> .

lodp:TranscriptomicsClaim a owl:Class ; rdfs:subClassOf lodp:Claim ;
    rdfs:label "transcriptomics claim" ;
    rdfs:comment "A claim from expression data about the PlantMetWiki nodes it measures (gene nodes; a pathway for pathway co-expression), stated as an rdf:Statement. It refers (sio:SIO_000628) to those nodes and carries no lodp:anchoredInPathway, lodp:anchorTier or wp:organism: the pathway and the organism are reached from the gene nodes by query (dcterms:isPartOf, wp:organism). shapes/common.ttl exempts it from the anchor rule (case 5)." .

lodp:GeneCoexpressionAssociation a owl:Class ;
    rdfs:subClassOf lodp:TranscriptomicsClaim , rdf:Statement , sio:SIO_001437 ;   # SIO_001437: gene-gene association (SIO_001257, used by lodp:GeneMetaboliteAssociation, is chemical-gene association)
    rdfs:label "gene co-expression association" ;
    rdfs:comment "Two genes are co-expressed across the samples of a dataset: the statement <gene A> obo:RO_0002610 'correlated with' <gene B>, with the two PlantMetWiki gene IRIs in alphabetical order (the relation is symmetric, so each pair has one claim). The sign is on each evidence node (lodp:direction obo:RO_0017003 positively or obo:RO_0017004 negatively correlated with). Also refers (sio:SIO_000628) to both genes; pathway and organism are reached from the genes by query." .

lodp:CoexpressionRun a owl:Class ;
    rdfs:subClassOf lodp:Run ;
    rdfs:label "co-expression run" ;
    rdfs:comment "Computation of correlation and mutual rank between gene expression profiles." .

# --- Differential expression -----------------------------------------------------------------------
lodp:DifferentialExpressionClaim a owl:Class ;
    rdfs:subClassOf lodp:TranscriptomicsClaim , rdf:Statement ;
    rdfs:label "differential expression claim" ;
    rdfs:comment "A gene's expression differs between the two conditions of a contrast: the statement <gene> lodp:differentiallyExpressedIn <contrast>. The contrast is an IRI with no statements of its own; its conditions (lodp:testCondition, lodp:referenceCondition), replicate counts, condition type and plant structure are stated on the claim. Also refers (sio:SIO_000628) to the PlantMetWiki gene node; the values (log2 fold change, test statistic, p-values) and the direction (lodp:direction) sit on the evidence node." .

lodp:DifferentialExpressionRun a owl:Class ;
    rdfs:subClassOf lodp:Run ;
    rdfs:label "differential expression run" ;
    rdfs:comment "A differential expression analysis (for example DESeq2 through nf-core/differentialabundance) over one dataset." .

lodp:differentiallyExpressedIn a owl:ObjectProperty ;
    rdfs:label "differentially expressed in" ;
    rdfs:comment "Holds between a gene and a contrast (test vs reference condition) when the gene's expression differs between the two conditions; the direction is stated on the evidence (lodp:direction). Close existing term: obo:BCGO_0000185 'differential expression context' (gene to biological context)." ;
    rdfs:seeAlso obo:BCGO_0000185 .

lodp:direction a owl:ObjectProperty ;
    rdfs:label "direction" ;
    rdfs:comment "The direction an evidence node finds for the relation of its claim, as a relation term: obo:RO_0002245 over-expressed in or obo:RO_0002246 under-expressed in (differential expression, response profile; relative to the reference condition or to the mean over all conditions), obo:RO_0017003 positively or obo:RO_0017004 negatively correlated with (co-expression)." .

lodp:conditionType a owl:ObjectProperty ;
    rdfs:label "condition type" ;
    rdfs:comment "What kind of condition a claim's contrast or condition is, as a class: efo:EFO_0000727 'treatment' (TX-20)." ;
    rdfs:seeAlso efo:EFO_0000727 .

lodp:testCondition a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "test condition" ;
    rdfs:comment "On a differential expression claim: the condition of its contrast whose expression is compared (numerator), as text, e.g. 'treatment: jasmonate'; lodp:log2FoldChange is positive when expression is higher here (nf-core/differentialabundance: 'target'). On an expression profile claim: the condition of its object, as text, e.g. 'treatment Ct, time_h 24'." .

lodp:referenceCondition a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "reference condition" ;
    rdfs:comment "On a differential expression claim: the condition of its contrast the test condition is compared against (denominator), as text (nf-core/differentialabundance: 'reference')." .

lodp:replicateCount a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:label "replicate count" ;
    rdfs:comment "On an expression profile claim: number of samples of its condition in the analysis, each in the role efo:EFO_0000683 'replicate' (TX-18). There are no sample nodes, so TX-18's class is used in this definition, not as a type." ;
    rdfs:seeAlso efo:EFO_0000683 .

lodp:testReplicateCount a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:label "test replicate count" ;
    rdfs:comment "On a differential expression claim: number of samples of the test condition (TX-18, as lodp:replicateCount)." ;
    rdfs:seeAlso efo:EFO_0000683 .

lodp:referenceReplicateCount a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:label "reference replicate count" ;
    rdfs:comment "On a differential expression claim: number of samples of the reference condition (TX-18, as lodp:replicateCount)." ;
    rdfs:seeAlso efo:EFO_0000683 .

lodp:plantStructure a owl:ObjectProperty ;
    rdfs:label "plant structure" ;
    rdfs:comment "The plant structure (tissue or organ) the samples of a claim's condition or contrast were taken from: a subclass of obo:PO_0009011 'plant structure' (TX-19), e.g. obo:PO_0009005 root, obo:PO_0025034 leaf. Same term as MET-24 for metabolomics samples." ;
    rdfs:seeAlso obo:PO_0009011 .

# --- Run: input matrix and normalisation (all TX runs) ----------------------------------------------
lodp:inputUnit a owl:ObjectProperty ;
    rdfs:label "input unit" ;
    rdfs:comment "Value type of the expression matrix a run read, as a class: obo:STATO_0000064 read counts (TX-03), obo:STATO_0000589 TPM, obo:STATO_0000172 FPKM or obo:STATO_0000206 RPKM (TX-04)." .

lodp:inputFile a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "input file" ;
    rdfs:comment "The expression matrix a run read: file name, path and source, as text." .

lodp:normalisationMethod a owl:ObjectProperty ;
    rdfs:label "normalisation method" ;
    rdfs:comment "Normalisation a run applied to the counts, as a class: obo:STATO_0000590 median of ratios (TX-05), the DESeq2 normalisation." ;
    rdfs:seeAlso obo:STATO_0000590 .

lodp:normalisedFile a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "normalised file" ;
    rdfs:comment "The normalised matrix a run wrote: file name and path, as text." .

# --- Response profile ------------------------------------------------------------------------------
lodp:ExpressionProfileClaim a owl:Class ;
    rdfs:subClassOf lodp:TranscriptomicsClaim , rdf:Statement ;
    rdfs:label "expression profile claim" ;
    rdfs:comment "A gene's expression in one condition is unusually high or low compared with its expression over all conditions of the experiment: the statement <gene> lodp:expressionDeviatesIn <condition>. The condition is an IRI with no statements of its own; what it stands for (lodp:testCondition), its replicate count, condition type and plant structure are stated on the claim. Also refers (sio:SIO_000628) to the PlantMetWiki gene node; the z-score, the condition mean and the direction (lodp:direction) sit on the evidence node. Not a test against a control." .

lodp:ExpressionProfileRun a owl:Class ;
    rdfs:subClassOf lodp:Run ;
    rdfs:label "expression profile run" ;
    rdfs:comment "Computation of per-condition means and z-scores of gene expression over the conditions of one dataset." .

lodp:expressionDeviatesIn a owl:ObjectProperty ;
    rdfs:label "expression deviates in" ;
    rdfs:comment "Holds between a gene and a condition when the gene's mean expression in that condition lies far from its mean over all conditions of the experiment (z-score on the evidence); the direction is stated on the evidence (lodp:direction)." .

# --- Pathway co-expression -------------------------------------------------------------------------
lodp:PathwayCoexpressionClaim a owl:Class ;
    rdfs:subClassOf lodp:TranscriptomicsClaim , rdf:Statement ;
    rdfs:label "pathway co-expression claim" ;
    rdfs:comment "The genes of a pathway are co-expressed more than random gene sets of the same size: the statement <pathway> rdf:type lodp:CoexpressedGenePathway (a property of one pathway, stated as class membership). The only TX claim about a pathway; also refers (sio:SIO_000628) to the pathway (PlantCyc ID or PlantMetWiki pathway IRI, open); its genes and organism are reached by query. The statistic, the empirical p-value and the number of genes and random sets sit on the evidence node." .

lodp:CoexpressedGenePathway a owl:Class ;
    rdfs:label "co-expressed gene pathway" ;
    rdfs:comment "A pathway whose genes are co-expressed more than random gene sets of the same size, in the data of the evidence. Used as the object of lodp:PathwayCoexpressionClaim statements." .

lodp:PathwayCoexpressionRun a owl:Class ;
    rdfs:subClassOf lodp:Run ;
    rdfs:label "pathway co-expression run" ;
    rdfs:comment "Computation of the mean pairwise correlation of a pathway's genes and its comparison with random gene sets of the same size (seed and number of sets in the version)." .

lodp:meanPairwiseCorrelation a owl:DatatypeProperty ; rdfs:range xsd:double ;
    rdfs:label "mean pairwise correlation" ;
    rdfs:comment "Mean Pearson correlation coefficient (obo:STATO_0000280, TX-14) over all pairs of a gene set." ;
    rdfs:seeAlso obo:STATO_0000280 .

lodp:geneCount a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:label "gene count" ;
    rdfs:comment "Number of genes a value was computed from (for a pathway: its genes found in the dataset)." .

lodp:randomSetCount a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:label "random set count" ;
    rdfs:comment "Number of random gene sets the empirical p-value was computed from; the smallest possible p-value is 1 / (count + 1)." .
